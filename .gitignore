# Extracted chat content NEVER belongs in this repo.
# By default it lives in ~/.droidread/ instead, which is outside the tree entirely —
# these rules are the second line of defence, not the first.
*.db
*.db-shm
*.db-wal
media/
data/
*.jpeg
*.jpg
*.webp
*.png
*.mp4
ui-dump*.xml

# Credentials
.env
.env.local

node_modules/

# Generated on first run of the web viewer. A committed TLS private key is a published
# private key.
web/cert.pem
web/key.pem

# Third-party, fetched by the operator: Genymobile/scrcpy's server jar (Apache-2.0).
web/scrcpy-server-v3.1
