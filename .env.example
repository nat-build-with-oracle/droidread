# Optional. Unset, droidread uses a local SQLite file at ~/.droidread/chats.db
# and nothing ever leaves the machine.
#
# Set these to sync the index to a Turso cloud database instead. The auth token is a
# real credential: keep it in .env (gitignored), never in a committed file.
# TURSO_DATABASE_URL=libsql://<your-db>.turso.io
# TURSO_AUTH_TOKEN=<token>

# Path to adb, if it isn't on PATH.
# DROIDREAD_ADB=/home/you/Android/Sdk/platform-tools/adb

# Override where extracted data is stored (default: ~/.droidread)
# DROIDREAD_HOME=/home/you/.droidread
